# MongoDB connection string, for example:
# mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=""

# Optional database name (defaults to dinkboard)
MONGODB_DB="dinkboard"

# Secret used to sign admin session cookies. Use a long random value.
# Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If omitted, the app falls back to MONGODB_URI, which is not recommended.
AUTH_SECRET=""

# Optional credential reference for local setup
MONGODB_USERNAME=""
MONGODB_PASSWORD=""
